+
+/* Verification badge.
+ *
+ * Four states get four colours and four shapes. Colour alone would fail for
+ * anyone who cannot distinguish them, and this is a security signal rather
+ * than decoration, so the label text carries the state as well.
+ */
+#bud-verification-badge {
+  align-items: center;
+  margin-inline: 4px;
+  padding-inline: 6px;
+  border-radius: 4px;
+  font-size: 0.85em;
+}
+
+#bud-verification-badge.bud-badge-verified {
+  background-color: color-mix(in srgb, #0b8043 18%, transparent);
+  color: #0b8043;
+}
+
+#bud-verification-badge.bud-badge-transport {
+  background-color: color-mix(in srgb, #5f6368 18%, transparent);
+  color: #5f6368;
+}
+
+#bud-verification-badge.bud-badge-claim {
+  background-color: color-mix(in srgb, #b06000 18%, transparent);
+  color: #b06000;
+}
+
+#bud-verification-badge.bud-badge-refused {
+  background-color: color-mix(in srgb, #c5221f 18%, transparent);
+  color: #c5221f;
+}
