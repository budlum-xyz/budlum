--- /dev/null
+++ b/browser/base/content/browser-budVerification.js
@@ -0,0 +1,98 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+/**
+ * The verification badge.
+ *
+ * Four states, matching budscan::evidence::Strength exactly. The mapping is
+ * one-to-one on purpose: a fifth UI state would be a claim the core never
+ * made, and merging two would hide a distinction the core measured.
+ *
+ * Ordering is weak-to-strong and the badge shows the weakest claim. A page
+ * whose bytes hash correctly but whose name resolution carried no proof is
+ * "claim only", not "verified": the bytes are what they say they are, and
+ * nobody proved they are the bytes this name points at.
+ */
+var gBudVerificationBadge = {
+  _element: null,
+
+  /**
+   * Strength -> [l10n id, css class].
+   *
+   * No lock icon anywhere. A lock means "the transport is protected", which
+   * is a different claim from "these bytes are the requested bytes", and
+   * reusing the icon would overwrite a meaning users spent years learning.
+   */
+  STATES: {
+    0: ["budscan-badge-refused", "bud-badge-refused"],
+    1: ["budscan-badge-claim-only", "bud-badge-claim"],
+    2: ["budscan-badge-transport-only", "bud-badge-transport"],
+    3: ["budscan-badge-verified", "bud-badge-verified"],
+  },
+
+  init() {
+    this._element = document.getElementById("bud-verification-badge");
+    gBrowser.addProgressListener(this);
+  },
+
+  uninit() {
+    gBrowser.removeProgressListener(this);
+    this._element = null;
+  },
+
+  onLocationChange(aWebProgress, aRequest, aLocation) {
+    this.update(aRequest, aLocation);
+  },
+
+  /**
+   * Refresh the badge for the current load.
+   *
+   * The default is Refused, not "nothing". A page whose strength could not be
+   * read is a page nobody measured, and an unmeasured page is not a verified
+   * one. Failing towards the strong end here would mean a bug in the channel
+   * silently produces a "verified" badge.
+   */
+  update(aRequest, aLocation) {
+    if (!this._element) {
+      return;
+    }
+
+    if (!aLocation || aLocation.scheme !== "bud") {
+      // Ordinary web. The badge is hidden rather than set to a low value:
+      // showing "transport only" on every https page would train users to
+      // ignore it, and an ignored badge measures nothing.
+      this._element.hidden = true;
+      return;
+    }
+
+    let strength = 0;
+    let badge = "";
+    try {
+      let channel = aRequest.QueryInterface(Ci.nsIBudChannel);
+      strength = channel.strength;
+      badge = channel.badgeText;
+    } catch (e) {
+      // Deliberately swallowed and deliberately left at Refused: the failure
+      // to read a strength is itself the answer.
+      strength = 0;
+      badge = "";
+    }
+
+    let [l10nId, cssClass] = this.STATES[strength] || this.STATES[0];
+    this._element.hidden = false;
+    this._element.className = cssClass;
+    document.l10n.setAttributes(this._element, l10nId);
+
+    // The full reason goes in the tooltip, from the core, untranslated: it
+    // names the layer and what it measured ("bud-fetcher: the ContentId
+    // of the bytes equals the manifest_id"). Rewriting it here would put a
+    // second author between the measurement and the user.
+    this._element.setAttribute("tooltiptext", badge);
+  },
+
+  QueryInterface: ChromeUtils.generateQI([
+    "nsIWebProgressListener",
+    "nsISupportsWeakReference",
+  ]),
+};
