+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#ifndef budscan_ffi_h
+#define budscan_ffi_h
+
+/*
+ * The C ABI between the Gecko patch layer and the budscan core.
+ *
+ * Every function here is implemented in Rust and called from C++; nothing
+ * in this header decides anything. The declarations are the contract the
+ * Rust side has to satisfy, written down so that BudChannel.cpp and
+ * BudProtocolHandler.cpp compile against a type-checked interface rather
+ * than against names the linker resolves and the compiler never saw.
+ *
+ * Ownership: a BudPage is created by the core and given back to it with
+ * budscan_page_free. The strings a page hands out live as long as the page.
+ * The reason string of a verdict is static.
+ */
+
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* The verdict of the name rule (budscan::name_rule::check_name). */
+typedef struct BudNameVerdict {
+  /* Non-zero when the name passes the rule. */
+  uint8_t ok;
+  /* When it does not: the property that failed, NUL-terminated UTF-8,
+   * static. Empty when `ok` is set. */
+  const char* reason;
+} BudNameVerdict;
+
+/* A resolved page: bytes, the strength of every claim on the way to them
+ * and the badge text. Opaque to C++. */
+typedef struct BudPage BudPage;
+
+/* Run the name rule over a bud:// spec. */
+BudNameVerdict budscan_check_name(const char* spec);
+uint8_t budscan_verdict_ok(BudNameVerdict verdict);
+const char* budscan_verdict_reason(BudNameVerdict verdict);
+
+/* Resolve, fetch and verify a bud:// spec. Never null: a failure at any
+ * step comes back as a page whose strength is Refused. */
+BudPage* budscan_open(const char* spec);
+
+/* An explanation page for a refusal, built from the reason the badge
+ * carries. Never null; freed with budscan_page_free like any page. */
+BudPage* budscan_refusal_page(const char* reason);
+
+/* budscan::evidence::Strength as its discriminant: 0 Refused,
+ * 1 RpcClaimOnly, 2 TransportOnly, 3 Verified. */
+uint8_t budscan_page_strength(const BudPage* page);
+
+/* The one-line badge for the address bar, NUL-terminated UTF-8. */
+const char* budscan_page_badge(const BudPage* page);
+
+/* The page bytes and their length. Empty for a Refused page. */
+const char* budscan_page_bytes(const BudPage* page);
+size_t budscan_page_len(const BudPage* page);
+
+/* Give a page back to the core. */
+void budscan_page_free(BudPage* page);
+
+#ifdef __cplusplus
+}  /* extern "C" */
+#endif
+
+#endif  /* budscan_ffi_h */
