+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#include "BudChannel.h"
+#include "nsStringStream.h"
+
+namespace mozilla {
+namespace net {
+
+BudChannel::BudChannel(nsIURI* aURI, nsILoadInfo* aLoadInfo,
+                       BudNameVerdict aVerdict)
+    : nsBaseChannel(), mVerdict(aVerdict) {
+  SetURI(aURI);
+  SetLoadInfo(aLoadInfo);
+  SetContentType("text/html"_ns);
+}
+
+nsresult BudChannel::OpenContentStream(bool aAsync, nsIInputStream** aStream,
+                                       nsIChannel** aChannel) {
+  nsAutoCString spec;
+  nsresult rv = URI()->GetSpec(spec);
+  NS_ENSURE_SUCCESS(rv, rv);
+
+  // A name that failed the rule never reaches resolution. The page it gets is
+  // an explanation, not a blank refusal.
+  if (!budscan_verdict_ok(mVerdict)) {
+    mStrength = BudStrength::Refused;
+    mBadge = budscan_verdict_reason(mVerdict);
+    return NS_NewCStringInputStream(aStream, budscan_refusal_page(mVerdict));
+  }
+
+  // Resolve, fetch and verify. Every one of those three steps happens in the
+  // Rust core and each contributes a claim; what comes back is already the
+  // weakest link.
+  BudPage page = budscan_open(spec.get());
+  mStrength = static_cast<BudStrength>(budscan_page_strength(page));
+  mBadge = budscan_page_badge(page);
+
+  if (mStrength == BudStrength::Refused) {
+    // Bytes may exist and still be refused: the hash did not match, the proof
+    // did not verify, or decryption failed. They are not handed to the parser
+    // under any of those conditions.
+    budscan_page_free(page);
+    return NS_NewCStringInputStream(aStream, budscan_refusal_page(mVerdict));
+  }
+
+  nsCString bytes(budscan_page_bytes(page), budscan_page_len(page));
+  budscan_page_free(page);
+  return NS_NewCStringInputStream(aStream, bytes);
+}
+
+}  // namespace net
+}  // namespace mozilla
--- a/netwerk/base/nsNetUtil.cpp
+++ b/netwerk/base/nsNetUtil.cpp
@@ -2712,6 +2712,10 @@ bool NS_IsSafeMethodNav(nsIChannel* aChannel) {
 
 bool NS_IsInternalSameURIRedirect(nsIChannel* aOldChannel,
                                   nsIChannel* aNewChannel, uint32_t aFlags) {
+  // bud:// never redirects: a name resolves to content, and if that content
+  // cannot be verified the load is refused rather than pointed somewhere
+  // else. A redirect here would let an unverifiable target borrow a verified
+  // name's origin.
   if (!(aFlags & nsIChannelEventSink::REDIRECT_INTERNAL)) {
     return false;
   }
