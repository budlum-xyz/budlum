+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#include "BudProtocolHandler.h"
+#include "BudChannel.h"
+#include "budscan_ffi.h"
+#include "nsNetUtil.h"
+#include "nsStandardURL.h"
+
+namespace mozilla {
+namespace net {
+
+NS_IMPL_ISUPPORTS(BudProtocolHandler, nsIProtocolHandler,
+                  nsISupportsWeakReference)
+
+NS_IMETHODIMP
+BudProtocolHandler::GetScheme(nsACString& aResult) {
+  aResult.AssignLiteral("bud");
+  return NS_OK;
+}
+
+NS_IMETHODIMP
+BudProtocolHandler::AllowPort(int32_t aPort, const char* aScheme,
+                              bool* aResult) {
+  // A name is not a host with a port. Allowing one would create two spellings
+  // of the same name and therefore two origins for one piece of content.
+  *aResult = false;
+  return NS_OK;
+}
+
+NS_IMETHODIMP
+BudProtocolHandler::NewChannel(nsIURI* aURI, nsILoadInfo* aLoadInfo,
+                               nsIChannel** aResult) {
+  NS_ENSURE_ARG_POINTER(aURI);
+  NS_ENSURE_ARG_POINTER(aLoadInfo);
+
+  nsAutoCString spec;
+  nsresult rv = aURI->GetSpec(spec);
+  NS_ENSURE_SUCCESS(rv, rv);
+
+  // The name rule runs here, before anything is resolved or fetched. It is
+  // the same rule budscan applies (budscan::name_rule::check_name); the
+  // budscan-name-rule-parity gate fails the build if the two disagree.
+  //
+  // A refusal is not an error return: the caller gets a channel that produces
+  // an explanation page. "It did not open" without a reason is not an answer
+  // a user can act on.
+  BudNameVerdict verdict = budscan_check_name(spec.get());
+
+  RefPtr<BudChannel> channel = new BudChannel(aURI, aLoadInfo, verdict);
+  channel.forget(aResult);
+  return NS_OK;
+}
+
+}  // namespace net
+}  // namespace mozilla
