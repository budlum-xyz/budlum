+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#ifndef mozilla_net_BudProtocolHandler_h
+#define mozilla_net_BudProtocolHandler_h
+
+#include "nsIProtocolHandler.h"
+#include "nsWeakReference.h"
+
+namespace mozilla {
+namespace net {
+
+/**
+ * The bud:// scheme.
+ *
+ * A bud:// URI names content on Budlum. Resolution and byte verification are
+ * done by the budscan core (Rust); this class is the Gecko-side surface and
+ * deliberately holds no verification logic of its own. Two places deciding
+ * what counts as verified is worse than one place deciding badly.
+ *
+ * Flags (the components.conf entry above declares none, so Gecko applies
+ * its defaults; this list is what the scheme is meant to carry and what a
+ * later `protocol_flags` line must not exceed):
+ *   URI_STD               - bud://<name>/<path> parses as a standard URL, so
+ *                           each name gets its own origin. Without this two
+ *                           different names would share one origin.
+ *   URI_LOADABLE_BY_ANYONE- an ordinary page may link to bud://.
+ *
+ * Not set, on purpose:
+ *   URI_IS_POTENTIALLY_TRUSTWORTHY - the bytes are hash-verified, but the
+ *                           name is not: .bud resolution carries no state
+ *                           proof today (`claim only`), so a lying node can
+ *                           put any bytes under any name. A potentially
+ *                           trustworthy origin unlocks service workers,
+ *                           `crypto.subtle` and secure cookies for those
+ *                           bytes. Until the resolution is `verified` the
+ *                           scheme stays an ordinary, non-secure context.
+ *   URI_DANGEROUS_TO_LOAD - would make the scheme unusable from the address
+ *                           bar, which is the only place it is used.
+ *   URI_IS_LOCAL_RESOURCE - bud:// is not local; it is content-addressed.
+ */
+class BudProtocolHandler final : public nsIProtocolHandler,
+                                 public nsSupportsWeakReference {
+ public:
+  NS_DECL_ISUPPORTS
+  NS_DECL_NSIPROTOCOLHANDLER
+
+  BudProtocolHandler() = default;
+
+ private:
+  ~BudProtocolHandler() = default;
+};
+
+}  // namespace net
+}  // namespace mozilla
+
+#endif  // mozilla_net_BudProtocolHandler_h
