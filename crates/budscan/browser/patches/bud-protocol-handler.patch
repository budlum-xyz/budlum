+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#ifndef mozilla_net_BudChannel_h
+#define mozilla_net_BudChannel_h
+
+#include "nsBaseChannel.h"
+
+namespace mozilla {
+namespace net {
+
+/**
+ * How strongly the bytes behind this channel were verified.
+ *
+ * Mirrors budscan::evidence::Strength. The order is weak-to-strong and the
+ * address bar shows the *weakest* claim in the chain: bytes that hash
+ * correctly under a resolution nobody proved are not verified content, they
+ * are verified bytes reached by an unproven route.
+ */
+enum class BudStrength : uint8_t {
+  Refused = 0,
+  RpcClaimOnly = 1,
+  TransportOnly = 2,
+  Verified = 3,
+};
+
+/**
+ * A channel over content that has already been verified.
+ *
+ * OpenContentStream never yields bytes whose strength is Refused. That is the
+ * whole point of this class: an unverified byte must not reach the HTML
+ * parser, because after that point nothing distinguishes it from a verified
+ * one.
+ */
+class BudChannel final : public nsBaseChannel {
+ public:
+  BudChannel(nsIURI* aURI, nsILoadInfo* aLoadInfo, BudNameVerdict aVerdict);
+
+  BudStrength Strength() const { return mStrength; }
+  const nsCString& BadgeText() const { return mBadge; }
+
+ protected:
+  nsresult OpenContentStream(bool aAsync, nsIInputStream** aStream,
+                             nsIChannel** aChannel) override;
+
+ private:
+  ~BudChannel() = default;
+
+  BudNameVerdict mVerdict;
+  BudStrength mStrength = BudStrength::Refused;
+  nsCString mBadge;
+};
+
+}  // namespace net
+}  // namespace mozilla
+
+#endif  // mozilla_net_BudChannel_h
