+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#include "BudChannel.h"
+#include "budscan_ffi.h"
+#include "mozilla/NullPrincipal.h"
+#include "mozilla/OriginAttributes.h"
+#include "nsILoadInfo.h"
+#include "nsStringStream.h"
+
+namespace mozilla {
+namespace net {
+
+BudChannel::BudChannel(nsIURI* aURI, nsILoadInfo* aLoadInfo,
+                       BudNameVerdict aVerdict)
+    : nsBaseChannel(), mVerdict(aVerdict) {
+  SetURI(aURI);
+  SetLoadInfo(aLoadInfo);
+  SetContentType("text/html"_ns);
+}
+
+// Hand a core-owned page to the parser and give the page back to the core.
+static nsresult StreamPage(BudPage* aPage, nsIInputStream** aStream) {
+  nsCString bytes(budscan_page_bytes(aPage), budscan_page_len(aPage));
+  budscan_page_free(aPage);
+  return NS_NewCStringInputStream(aStream, bytes);
+}
+
+nsresult BudChannel::OpenContentStream(bool aAsync, nsIInputStream** aStream,
+                                       nsIChannel** aChannel) {
+  nsAutoCString spec;
+  nsresult rv = URI()->GetSpec(spec);
+  NS_ENSURE_SUCCESS(rv, rv);
+
+  // A name that failed the rule never reaches resolution. The page it gets is
+  // an explanation, not a blank refusal.
+  if (!budscan_verdict_ok(mVerdict)) {
+    mStrength = BudStrength::Refused;
+    mBadge = budscan_verdict_reason(mVerdict);
+    return StreamPage(budscan_refusal_page(mBadge.get()), aStream);
+  }
+
+  // Resolve, fetch and verify. Every one of those three steps happens in the
+  // Rust core and each contributes a claim; what comes back is already the
+  // weakest link.
+  BudPage* page = budscan_open(spec.get());
+  mStrength = static_cast<BudStrength>(budscan_page_strength(page));
+  mBadge = budscan_page_badge(page);
+
+  if (mStrength == BudStrength::Refused) {
+    // Bytes may exist and still be refused: the hash did not match, the proof
+    // did not verify, or decryption failed. They are not handed to the parser
+    // under any of those conditions.
+    budscan_page_free(page);
+    return StreamPage(budscan_refusal_page(mBadge.get()), aStream);
+  }
+
+  if (mStrength < BudStrength::Verified) {
+    // The bytes hash correctly but the route to them was not proven: an RPC
+    // answered without a proof, or TLS said who sent them and nothing said
+    // what they were. They are shown, and the badge says so, but not as
+    // bud://<name>. Under that origin they would read and write what the
+    // name's verified pages stored and speak to other pages as the name; a
+    // node that answers a resolution with bytes of its own choosing would
+    // borrow the name's origin for them. An opaque principal gives these
+    // bytes an origin of their own, shared with nothing, while the address
+    // bar still says which name was asked for and how far it was verified.
+    nsCOMPtr<nsILoadInfo> loadInfo = LoadInfo();
+    OriginAttributes attrs = loadInfo->GetOriginAttributes();
+    nsCOMPtr<nsIPrincipal> opaque = NullPrincipal::Create(attrs);
+    SetOwner(opaque);
+  }
+
+  return StreamPage(page, aStream);
+}
+
+}  // namespace net
+}  // namespace mozilla
