+/**
+ * The JS surface of the budscan core.
+ *
+ * Nothing here decides anything. Every function forwards to Rust and returns
+ * what came back. The reason is the same one that keeps the name rule out of
+ * the C++ protocol handler: two places deciding what a name may contain,
+ * disagreeing, is worse than one place deciding badly.
+ *
+ * In particular this file does not:
+ *   - lowercase a name (that would map UPPER.bud and upper.bud onto one
+ *     record and make ownership a race);
+ *   - strip whitespace beyond the trim the core already does;
+ *   - guess a scheme for a bare domain;
+ *   - decode punycode back to Unicode for display.
+ */
+
+const lazy = {};
+
+ChromeUtils.defineLazyGetter(lazy, "core", () => {
+  return ChromeUtils.importESModule("resource://gre/modules/BudScanCore.sys.mjs");
+});
+
+export var BudScan = {
+  /**
+   * How a name should be drawn in the address bar.
+   *
+   * A name that passes the rule is returned unchanged. One that does not is
+   * returned with every non-ASCII label punycoded.
+   */
+  displayForm(spec) {
+    return lazy.core.displayForm(spec);
+  },
+
+  /**
+   * Does this name pass the rule?
+   *
+   * Returns null when it passes, or a reason string naming the property that
+   * failed. A caller that only needs a boolean should still surface the
+   * reason: "it did not open" is not something a user can act on.
+   */
+  checkName(name) {
+    return lazy.core.checkName(name);
+  },
+
+  /**
+   * Classify what was typed without resolving it.
+   *
+   * Returns one of: "name", "bud-address", "evm-address", "content-id",
+   * "cid", "nft-id", "block-height", "tx-hash", "https-url", "free-text",
+   * "ambiguous", "refused-scheme", "refused-name".
+   *
+   * "ambiguous" is a real answer and not a failure. Thirty-two bytes of hex
+   * is a wallet address, a content id and a transaction hash at the same
+   * time, and picking one would send the user somewhere they did not ask to
+   * go.
+   */
+  classify(input) {
+    return lazy.core.classify(input);
+  },
+};
