<?xml version="1.0" encoding="utf-8"?>
<!-- Never transfer wallet/operator key material or validator custody state,
     including device-to-device migration on Android 12+. For API 29/30,
     the manifest also sets allowBackup=false and fullBackupContent=false. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
