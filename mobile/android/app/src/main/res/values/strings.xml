    <string name="notif_status_template">Stored: %1$s | Last audit: %2$s | Net: %3$s</string>
    <string name="notif_boot_resume_title">Budlum Validator Duties Unavailable</string>
    <string name="notif_boot_resume_body">Validator duties are not connected yet. Audits are not running. Reopen the app to view its status.</string>
    <string name="onboarding_disclosure">This build does not store or audit network content. Future validators may store erasure-coded shares, and sealed content must remain end-to-end encrypted. Faucet requests may perform bounded anti-bot proof of work, not block mining.</string>
    <string name="security_tradeoff_note">Owner spend, staking, rotation and unbonding are unavailable. This phone holds a wallet and can sign with it, but no Keystore-backed biometric or PIN authorization guards that signature yet. Operator and BLS key wrapping alone does not make validator duties operational.</string>
    <string name="action_faucet_request">Submit faucet request (100 BUD)</string>
    <string name="validator_unavailable">Registering stake on the chain is not wired to this screen yet. The faucet sends test tokens to the address above; it does not create a stake.</string>
    <string name="faucet_explanation">Enter the HTTPS origin of your testnet faucet and the 0x-prefixed 32-byte address of a wallet you control. This phone makes its own wallet, so the address above can be its own. Never type your twenty-four words into a faucet, here or anywhere else. A submitted transfer is not a confirmed balance. The faucet may limit requests by address and IP.</string>
    <string name="faucet_endpoint">Faucet HTTPS origin (https://faucet.your-domain)</string>
    <string name="faucet_wallet_address">Your wallet address (0x…)</string>
    <string name="faucet_pending">Solving the faucet challenge and submitting request…</string>
    <string name="faucet_submitted">Transfer submitted, not yet confirmed. Check the transaction hash in a chain explorer before assuming any funds are available:</string>
    <string name="faucet_invalid_endpoint">Enter a valid HTTPS faucet origin, without a path, query or credentials.</string>
    <string name="faucet_invalid_address">Enter a nonzero, 32-byte hex wallet address.</string>
    <string name="faucet_invalid_challenge">Faucet challenge is invalid, expired or for another chain. No request was submitted.</string>
    <string name="faucet_proof_too_hard">Faucet challenge exceeded the phone\'s work limit or expired. No request was submitted.</string>
    <string name="faucet_rate_limited">Faucet rate limit reached. Wait before trying again.</string>
    <string name="faucet_unavailable">Faucet is temporarily unavailable. Try later.</string>
    <string name="faucet_rejected">Faucet rejected the request or its proof. Check the endpoint and wallet address, then wait before retrying.</string>
    <string name="faucet_network_error">Request or reply failed. A transfer may still have been submitted; check your wallet before retrying.</string>
    <string name="faucet_invalid_receipt">Faucet sent an invalid receipt. No balance was credited; check your wallet independently.</string>
    <string name="balance_explanation">Read-only account lookup. Enter a trusted testnet RPC HTTPS origin below, then refresh after a faucet request. A node-reported balance is not a verified account proof, finality, or proof you own the address; this app still cannot stake or spend.</string>
    <string name="balance_rpc_endpoint">Testnet RPC HTTPS origin (https://rpc.your-domain)</string>
    <string name="balance_refresh">Read RPC balance</string>
    <string name="balance_pending">Checking chain and reading account balance…</string>
    <string name="balance_reported">RPC-reported balance: %1$s BUD (%2$s atoms) for %3$s. Not proof-verified or guaranteed finalized.</string>
    <string name="balance_wrong_chain">RPC does not report Budlum testnet chain ID 45261. Balance refused.</string>
    <string name="balance_unavailable">RPC rejected the request or redirected it. No balance was read.</string>
    <string name="balance_invalid_response">RPC response was invalid or too large. No balance was read.</string>
    <string name="balance_network_error">RPC connection failed. No balance was read; try again later.</string>
