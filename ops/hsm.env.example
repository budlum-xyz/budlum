# Example only. Install as /etc/budlum/hsm.env with mode 0600 and owner
# root:budlum. Never commit a populated file.
# BUDLUM_HSM_PIN is the SoftHSM2 user PIN chosen during token
# initialisation. The node reads the variable name, not its value, from
# --pkcs11-token-pin-env.
BUDLUM_HSM_PIN=CHANGE_ME_AT_TOKEN_INITIALISATION
